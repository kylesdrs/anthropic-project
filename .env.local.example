# Mapbox is not currently integrated. The site map is drawn with plain SVG,
# so no Mapbox token is needed. Leave this out unless you wire Mapbox back in.
# NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Anthropic API (for Claude-powered briefings). Server-side only — never prefix with NEXT_PUBLIC.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Willyweather API (for swell data)
WILLYWEATHER_API_KEY=your_willyweather_api_key_here
